# Copy to .env and fill in locally. NEVER commit .env (the repo is public).
# Placeholders only: no real hosts, IPs, usernames or keys belong in this file.

# --- Database (local Docker Compose defaults) ---
POSTGRES_USER=yats
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=yats
# Host port for Postgres, published on 127.0.0.1 only (for running the app or psql outside Compose).
POSTGRES_PORT=5432
# For tools running on your machine. Built from the variables above, so the password lives in one place.
# Inside Compose, the app, worker and migrate services get DATABASE_URL pointing at the `db` service instead.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- App ---
APP_PORT=3000

# --- LLM adapter (see packages/llm) ---
# mock = no network calls (default, used in tests and CI).
# openai-compatible = any OpenAI-compatible /v1 endpoint (local Ollama/llama.cpp, hosted APIs).
LLM_PROVIDER=mock
LLM_BASE_URL="http://<your-llm-host>:11434/v1"
LLM_MODEL="<model-name>"
LLM_MONTHLY_CAP_EUR=20
# Leave empty for mock/local providers; paste a hosted key only in your local .env.
LLM_API_KEY=
